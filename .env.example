# Provider: auto | demo | openai
# auto = use the OpenAI-compatible endpoint when configured, otherwise the demo fixture
SWARMOS_PROVIDER=auto

# Optional OpenAI-compatible chat-completions endpoint.
# SwarmOS does not assume any assistant product exposes a public model API.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_FAST=
OPENAI_COMPAT_MODEL_STRONG=

# USD per 1M tokens. Leave at 0 when unknown: cost stays 0 and USD budgeting is
# not enforced (call and wall-clock limits still apply).
FAST_INPUT_USD_PER_MILLION=0
FAST_OUTPUT_USD_PER_MILLION=0
STRONG_INPUT_USD_PER_MILLION=0
STRONG_OUTPUT_USD_PER_MILLION=0
SWARMOS_PROVIDER_TIMEOUT_SECONDS=90

# Process ceiling for a single run. Requests may lower these, never raise them.
SWARMOS_MAX_AGENT_CALLS=24
SWARMOS_MAX_BUDGET_USD=0.50
SWARMOS_MAX_WALL_SECONDS=300
SWARMOS_MAX_RETRIES=2
SWARMOS_MAX_REVISIONS=1
SWARMOS_MAX_ESCALATIONS=1

# Conservative amount reserved before each paid call.
SWARMOS_RESERVATION_USD=0.02

# Verification runs this command inside the run's temporary workspace.
SWARMOS_VERIFY_COMMAND=python -m pytest -q
SWARMOS_VERIFY_TIMEOUT_SECONDS=120

# Paths. Relative paths resolve against the repository root.
SWARMOS_DB_PATH=swarmos.db
SWARMOS_SAMPLE_PROJECT=samples/sample_project
SWARMOS_FRONTEND_DIST=frontend/dist