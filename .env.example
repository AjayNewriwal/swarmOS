# Provider selection: auto | demo | openai
# auto = use the endpoint when OPENAI_COMPAT_BASE_URL and
# OPENAI_COMPAT_MODEL_FAST are set, otherwise the demo fixture.
SWARMOS_PROVIDER=auto

# OpenAI-compatible endpoint.
#
# Ollama (local):      http://127.0.0.1:11434/v1     key: leave empty
# vLLM (local):        http://127.0.0.1:8000/v1      key: leave empty
# llama.cpp server:    http://127.0.0.1:8080/v1      key: leave empty
# LM Studio (local):   http://127.0.0.1:1234/v1      key: leave empty
# Hosted compatible:   the provider's documented base URL and key
#
# SwarmOS never assumes a chat product exposes a public model API, and no
# hosted provider is treated as free by default.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_FAST=
# Must be a DIFFERENT model id to enable escalation. If it equals the fast
# model, SwarmOS reports that escalation is unavailable instead of pretending.
OPENAI_COMPAT_MODEL_STRONG=

# Role -> profile routing. Profiles are "fast" and "strong".
# Example: planner=strong,coder=fast,reviewer=strong
SWARMOS_ROLE_MODELS=
# Default policy for requests that do not choose one:
# config | fast_only | adaptive | role_routed
SWARMOS_MODEL_POLICY=config

# USD per 1M tokens. USD is only treated as an enforced budget when BOTH input
# and output rates are set for every profile that can be used. Otherwise cost
# stays an estimate and call/time limits govern.
FAST_INPUT_USD_PER_MILLION=0
FAST_OUTPUT_USD_PER_MILLION=0
STRONG_INPUT_USD_PER_MILLION=0
STRONG_OUTPUT_USD_PER_MILLION=0

SWARMOS_PROVIDER_TIMEOUT_SECONDS=90
SWARMOS_RETRY_BACKOFF_SECONDS=0.5
# Ask for JSON mode when the server supports it. SwarmOS downgrades once if a
# server rejects response_format.
SWARMOS_JSON_MODE=1
# Characters of workspace content sent to each agent call.
SWARMOS_SNAPSHOT_CHAR_LIMIT=400000

# Process ceiling for a single run. Requests may lower these, never raise them.
SWARMOS_MAX_AGENT_CALLS=24
SWARMOS_MAX_BUDGET_USD=0.50
SWARMOS_MAX_WALL_SECONDS=300
SWARMOS_MAX_RETRIES=2
SWARMOS_MAX_REVISIONS=1
SWARMOS_MAX_ESCALATIONS=1
SWARMOS_RESERVATION_USD=0.02

# Verification runs this command inside the run's temporary workspace.
SWARMOS_VERIFY_COMMAND=python -m pytest -q
SWARMOS_VERIFY_TIMEOUT_SECONDS=120
# Set to 0 to disable subprocess execution entirely.
SWARMOS_EXECUTION_ENABLED=1
# Only these binaries may run. No shell is invoked.
SWARMOS_ALLOWED_COMMANDS=python,python3,py,pytest
# Copying a real repository checkout into a workspace is disabled by default.
# There is no tested live-repository workflow yet.
SWARMOS_ALLOW_REPO_CHECKOUT=0

# Optional bearer token for /api. Strongly recommended whenever the API is
# reachable by anything other than localhost.
SWARMOS_API_TOKEN=
# Binding a non-loopback host also requires SWARMOS_ALLOW_REMOTE_BIND=1.
SWARMOS_ALLOW_REMOTE_BIND=0

# Paths. Relative paths resolve against the repository root.
SWARMOS_DB_PATH=swarmos.db
SWARMOS_SAMPLE_PROJECT=samples/sample_project
SWARMOS_FRONTEND_DIST=frontend/dist